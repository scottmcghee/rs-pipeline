# Copy to .env (never commit it) and export, e.g. `set -a; . ./.env; set +a`.

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=stocks
DB_USER=postgres
DB_PASSWORD=

# live (Yahoo + optional vendors below) or synthetic (offline demo market)
RS_SOURCE=live
# The benchmark: the ETF every other ETF is measured against
RS_REF_TICKER=SPY
# Broad-market ETFs that get no ETF-vs-benchmark metrics or ETF rank
# (RS_REF_TICKER always counts as one). Stocks are still ranked within them.
RS_BENCHMARK_TICKERS=SPY,QQQ,IWM
# First date fetched for a ticker with no stored prices
RS_HISTORY_START=2020-01-01

# Optional: Twelve Data price fallback (install with `uv sync --extra twelvedata`)
TWELVE_DATA_API_KEY=
# ETF holdings for onboarding (--indices), tried in this order:
#   a directory of <etf>.csv files (lower-case name, one `ticker` column)...
HOLDINGS_CSV_DIR=
#   ...then the AlphaVantage ETF_PROFILE API
AV_API_KEY=
